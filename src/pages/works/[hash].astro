---
// src/pages/works/[hash].astro
import { getCollection, render } from 'astro:content';
import { getWorkImagesSync } from '@utils/imageUtils';
import Layout from '@layouts/Layout.astro';
import { Picture, getImage } from 'astro:assets';

// Generate routes for all works
export async function getStaticPaths() {
  const works = await getCollection('works');

  return works.map((work) => ({
    params: {
      hash: work.data.hash,
    },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);

// Le immagini di un lavoro vivono in un contenitore che va dal 100% al 90vw
// (max 1920px): nessuna serve oltre i 1920. Con la Netlify Image CDN queste
// varianti non costano build: sono URL, e la trasformazione avviene all'edge.
// Le larghezze seguono dove cade davvero il contenitore: 90vw sopra 801px,
// 100vw sotto. Con 1668 al posto di 1296, uno schermo da 1440 (il portatile
// più diffuso) chiedeva 1668 px per mostrarne 1296: +29% di lato, cioè +34%
// di byte (264 kB contro 175 kB sulla stessa foto). Con 1536 e 1728 coperti,
// nessuna larghezza comune resta scoperta.
const IMAGE_WIDTHS = [640, 828, 1080, 1296, 1536, 1728, 1920];
const IMAGE_SIZES = '(min-width: 801px) 90vw, 100vw';

// Get all images for this work automatically
const imageUrls = getWorkImagesSync(work.data.hash);
const firstImage = imageUrls[0];
const remainingImages = imageUrls.slice(1);

const ogImageObj = firstImage
  ? await getImage({ src: firstImage, width: 1200, height: 630, format: 'jpg' })
  : null;
const ogImage = ogImageObj ? new URL(ogImageObj.src, Astro.site).toString() : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<style>
  .intro {
    /* Su mobile il corpo è 1rem (16 px), come i paragrafi del profilo: il
       paragrafo sta in una colonna di 306 px (390 di viewport meno 2×2.5svh di
       margine per lato) e a 17,6 px la giustificazione non regge — gli spazi
       passavano da 5 a 22,6 px sulla stessa colonna. Con 16 px e la
       sillabazione attiva (il documento è lang="en") restano 4,5–10,1 px, e le
       righe scendono da 24 a 21. Da 801 px corpo e sillabazione tornano quelli
       di prima: il desktop non cambia. */
    font-size: 1rem;
    text-align: left;

    p {
      text-align: justify;
      -webkit-hyphens: auto;
      hyphens: auto;
      margin-left: calc(var(--space) * 2);
      margin-right: calc(var(--space) * 2);
    }

    table {
      padding: var(--space) calc(var(--space) * 2) calc(var(--space) * 2);
      display: block;
      font-size: 1rem;
    }

    table a {
      text-transform: none;
    }

    table a:hover {
      color: black;
    }

    table td:first-child {
      width: 13ch;
      font-style: italic;
    }

    table td {
      text-align: left;
      padding-bottom: 0.25rem;
      vertical-align: baseline;
    }

    /* Deve stare annidata: p e table generati dal markdown non portano
       l'attributo di scoping di Astro (data-astro-cid-…), quindi `& p` compila
       in `.intro[cid] p` e li tocca, mentre un selettore scritto per esteso
       dentro un @media esterno — `.intro[cid] p[cid]` — non li toccherebbe
       mai. Per lo stesso motivo le due regole td dei media query qui sotto
       erano codice morto e sono state portate dentro il blocco. */
    @media (min-width: 801px) {
      p {
        -webkit-hyphens: manual;
        hyphens: manual;
      }
    }

    @media (max-width: 800px) {
      table td:first-child {
        padding-top: 0.5rem;
      }

      table td {
        width: fit-content;
      }
    }
  }

  @media (min-width: 801px) {
    .intro {
      font-size: 1.1rem;
      text-align: justify;
    }
  }

  .image_wrap {
    width: 100%;
    display: block;
    margin: 0 0 calc(var(--space) * 0.5);

    img {
      width: 100%;
      height: auto;
    }
  }
  body.work .see_more.hide {
      display: block;
  }

</style>

<Layout
  title={work.data.title}
  bodyClass='work'
  description={work.data.description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
>
  <main class={'bungkus ' + work.data.project} id="main">
    <!-- Display first image before h2 title -->
    {
      firstImage && (
        <div class='image_wrap'>
          <Picture
            src={firstImage}
            alt={work.data.project}
            width={1920}
            widths={IMAGE_WIDTHS}
            sizes={IMAGE_SIZES}
            formats={['avif', 'webp']}
            fallbackFormat='webp'
            quality={65}
            priority
          />
        </div>
      )
    }

    <h1 class='work_name'>{work.data.project}</h1>

    <section class='text_content intro'>
      <Content />
    </section>

    <!-- For remaining images, use Picture component too -->
    <section class='image_content'>
      {
        remainingImages.map((imageObj, index) => (
          <div class='image_wrap'>
            {/*
              Le foto della galleria non hanno didascalia: l'alt generato
              prima ("titolo del sito - Image 3") faceva annunciare a uno
              screen reader il nome di Binocle seguito da un numero, 12
              volte per pagina. Il nome dell'opera e' gia' nel h1, quindi
              qui l'informazione utile e' la posizione nella serie.
              Nota: alt='' sarebbe la scelta da immagine decorativa, ma il
              compilatore di Astro 7 scarta gli attributi con valore vuoto
              (verificato: alt="" non arriva nel build, con o senza
              compressHTML), e un <img> senza alt e' peggio.
            */}
            <Picture
              src={imageObj}
              alt={`${work.data.project} — photo ${index + 2} of ${imageUrls.length}`}
              width={1920}
              widths={IMAGE_WIDTHS}
              sizes={IMAGE_SIZES}
              formats={['avif', 'webp']}
              fallbackFormat='webp'
              quality={65}
              loading='lazy'
              decoding='async'
            />
          </div>
        ))
      }

      {imageUrls.length === 0 && <p>No images found for this work.</p>}
    </section>
  </main>

  <script>
    // D7 — Chrome chiede una foto `lazy` solo quando dista meno di ~1250 px
    // dallo schermo: chi scorre un'opera vede un vuoto di 1-2 s davanti a ogni
    // immagine (misurato: 12 foto, 3,0 MB, due ondate).
    //
    // Un osservatore sul viewport non servirebbe: quando una foto è in vista, le
    // due successive sono già dentro la soglia del browser e stanno scaricando.
    // Quindi si anticipa diversamente: finite le prime, il resto della galleria
    // si scarica in sottofondo, una foto per volta nei momenti di inerzia della
    // pagina (requestIdleCallback), fermandosi se la scheda va in background e
    // riprendendo al ritorno.
    //
    // Sono le foto che l'utente sta per vedere: il totale scaricato non cambia,
    // cambia quando. Per scelta dello studio vale anche su dati mobili.
    //
    // Il precaricamento non costruisce richieste a mano: cambia `loading` da
    // "lazy" a "eager" sulle foto successive. Così la scelta del formato
    // (avif) e della larghezza la fa il browser consultando i <source> del
    // <picture>, come farebbe da solo, e la foto è già in cache quando arriva
    // sullo schermo.
    const foto = Array.from(document.querySelectorAll<HTMLImageElement>(".image_content img"));
    if (foto.length > 0) {
      let indice = 0;
      let inVolo = 0;
      const MAX_IN_VOLO = 2;

      // Due foto per volta, non di più: quelle fuori schermo le scarica il
      // browser a priorità bassa, quindi non rubano banda a quella che l'utente
      // sta guardando, e con due in parallelo la galleria è pronta in pochi
      // secondi.
      //
      // Il trucco è `loading = "eager"` sull'<img>, non una Image() separata.
      // Un'Image() costruita a mano non conosce i <source> del <picture> e
      // scarica il fallback webp alla larghezza sbagliata — misurato: 828 px in
      // webp, 1,2 MB di byte che il browser non avrebbe mai usato. Cambiando
      // `loading`, invece, la scelta del formato e della larghezza la fa il
      // browser, esattamente come quando la foto entra nello schermo.
      const riempi = () => {
        if (document.hidden) return; // riparte su visibilitychange
        while (inVolo < MAX_IN_VOLO && indice < foto.length) {
          const img = foto[indice++];
          if (img.dataset.prefetched === "1" || img.complete) continue;
          img.dataset.prefetched = "1";
          inVolo++;
          const fatto = () => {
            inVolo--;
            if ("requestIdleCallback" in window) {
              requestIdleCallback(riempi, { timeout: 4000 });
            } else {
              setTimeout(riempi, 300);
            }
          };
          img.addEventListener("load", fatto, { once: true });
          img.addEventListener("error", fatto, { once: true });
          img.loading = "eager";
        }
      };

      const avvia = () => {
        if ("requestIdleCallback" in window) {
          requestIdleCallback(riempi, { timeout: 2000 });
        } else {
          setTimeout(riempi, 800);
        }
      };

      if (document.readyState === "complete") {
        avvia();
      } else {
        window.addEventListener("load", avvia, { once: true });
      }
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) riempi();
      });
    }
  </script>
</Layout>
