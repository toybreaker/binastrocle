---
// src/components/Footer.astro
//
// Il fondo di una pagina opera era un vicolo cieco: un triangolo che riportava
// in cima e nient'altro. Per tornare alle altre opere bisognava risalire e
// cliccare il logo in testa, sapendo che il logo è il menu. Ora due parole
// dicono dove si va, e il sito ha un link in entrata verso l'indice che prima non esisteva.
//
// Scelta dello studio (13-14/11/2026): due testi invece di due icone, perché
// l'hamburger in questa pagina significa già "apri il pannello" (il logo) e una
// griglia sarebbe un glifo da indovinare. `BACK TO TOP` è vero perché in cima
// si è stati; `ALL WORKS` lo è anche per chi arriva da una ricerca e non è mai
// stato nell'indice — "back to works" no.
const sullIndice = Astro.url.pathname.replace(/\/+$/, '') === '/works';
---

<style>
  .footer {
    display: block;
    margin-top: var(--space);
    margin-bottom: var(--space);
    padding-bottom: calc(var(--space) * 0.5);
    width: 100%;
    text-align: center;
  }

  /* La riga in fondo. Sotto i 481 px è larga quanto la finestra meno i margini
     dello studio, e le due etichette stanno ai bordi: la distanza fra loro si
     adatta alla larghezza. 44 px di altezza minima perché due parole in
     maiuscolo a 0,8rem sono ~14 px di glifo, e il triangolo che sostituiscono
     era 2,75rem. */
  .fondo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
    padding-inline: calc(var(--space) * 2);
  }

  .fondo :global(a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.25rem;
    font-size: 0.8rem;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--link_color);
  }

  .fondo :global(a:hover) {
    color: #000;
  }

  /* L'anello di focus va sull'elemento che si tocca. La regola che esiste in
     main.css lo disegna sull'SVG (.go_home:focus-visible svg), che qui non c'è,
     e `.go_home:focus-visible` spegne l'outline del contenitore: senza questa
     riga l'unica uscita dalla pagina sarebbe invisibile da tastiera. */
  .fondo :global(a:focus-visible) {
    outline: 2px solid var(--link_color);
    outline-offset: 0.35rem;
    border-radius: 2px;
  }

  /* Da 481 px in su la riga ha una larghezza fissa (26rem, 416 px) e resta
     centrata: la distanza fra le due etichette è sempre 162 px e ciò che cresce
     con la finestra è lo spazio ai lati. Prima questa regola partiva da 801 px e
     nella fascia 481-800 tornava la riga da 46rem, con le etichette a 440 px
     l'una dall'altra: la soglia è a 481 perché lì il salto è 169 → 162 px. */
  @media (min-width: 481px) {
    .fondo {
      max-width: 26rem;
      padding-inline: 0;
    }

    .fondo :global(a) {
      font-size: 1rem;
      font-weight: 400;
    }
  }

  /* Col testo ingrandito dall'utente (Firefox Android può stare al 150%) le due
     etichette non entrano più nella riga: 309 px richiesti in 285 disponibili a
     390 di larghezza. Meglio che vadano a capo, non che si accavallino. */
  @media (max-width: 480px) {
    .fondo {
      flex-wrap: wrap;
      row-gap: 0.25rem;
    }
  }
</style>

<footer class='footer'>
  <span class='go_home see_more'>
    <span class='fondo'>
      <a href='#top'>Back to top</a>
      {sullIndice ? null : <a href='/works/'>All works</a>}
    </span>
  </span>

  <span
    class='go_home'
    id='toggle_about_binocle'
    role='button'
    tabindex='0'
    aria-controls='profile'
    aria-expanded='false'
    aria-label='Open the profile'
  >
    <svg id='binocle_mini_logo' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 680.315 680.315'>
      <path
        d='M184.093 196.549c-82.96 0-141.659 60.658-141.659 142.442v3.132c0 80.609 55.958 142.05 141.659 142.05 85.7 0 141.658-61.44 141.658-142.05v-3.132c0-81.784-58.699-142.442-141.658-142.442zm86.875 144.792c0 24.109-5.332 44.928-14.983 61.354-10.649 18.125-26.634 30.783-46.83 36.343a90.968 90.968 0 0 1-24.278 3.265c-50.874 0-88.05-39.527-88.05-100.573v-3.131c0-60.259 32.482-100.567 87.266-100.567 29.888 0 52.958 12.758 67.811 33.638 9.77 13.732 15.929 30.992 18.101 50.522.578 5.205.963 10.518.963 16.019v3.13zm303.576 61.354c-10.649 18.125-26.636 30.783-46.83 36.344a91.015 91.015 0 0 1-24.278 3.262c-50.874 0-88.05-39.525-88.05-100.571v-3.132c0-60.258 32.481-100.566 87.265-100.566 29.889 0 52.958 12.758 67.812 33.637 4.983 7.007 9.017 14.943 12.07 23.62h55.753c-16.958-58.78-68.304-98.739-135.636-98.739-82.96 0-141.658 60.658-141.658 142.442v3.132c0 80.608 55.958 142.049 141.658 142.049 68.736 0 118.306-39.541 135.25-96.778h-56.163c-2.039 5.434-4.415 10.569-7.193 15.3z'
      ></path>
    </svg>
  </span>
</footer>
