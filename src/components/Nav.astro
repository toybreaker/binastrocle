---
// src/components/Nav.astro
import { getCollection } from 'astro:content';

// Get all works from the content collection
const works = await getCollection('works');

// Sort works by year descending (newest first), then by project name as secondary sort
const sortedWorks = works.sort((a, b) => {
  // First sort by year descending
  if (b.data.year !== a.data.year) {
    return b.data.year - a.data.year;
  }
  // If years are the same, sort by project name alphabetically
  return a.data.project.localeCompare(b.data.project);
});

// `trailingSlash: 'always'`: le URL si servono e si linkano con la barra
// finale, quindi anche il confronto per la voce corrente va fatto sulla forma
// normalizzata — altrimenti `/works/x/` non combacia con `/works/x` e la voce
// attiva smette di accendersi, in silenzio.
const normalize = (path: string): string => path.replace(/\/+$/, "") || "/";

// Get current page path for active state (optional)
const currentPath = normalize(Astro.url.pathname);
---

<style>
  .menu {
    list-style: none;
    padding: 0;
    margin: var(--space) 0;
  }

  .menu li {
    text-align: center;
    margin: 0.5rem 0;
  }

  .menu li a {
    display: block;
    width: 100%;
    text-transform: uppercase;
    font-weight: 400;
    font-size: 1rem;
  }

  @media (min-width: 601px) {
    .menu li a {
      font-size: 1.5rem;
    }
  }

  .menu li a:hover {
    color: var(--link_color_light);
  }

  .menu li a.active {
    color: var(--link_color_light);
  }
</style>

<nav aria-label='Works'>
  <ul class='menu hide' id='menu'>
    {
      sortedWorks.map((work) => {
        const workUrl = `/works/${work.data.hash}/`;
        const isActive = currentPath === normalize(workUrl);

        return (
          <li>
            <a
              href={workUrl}
              class={isActive ? 'active' : undefined}
              aria-current={isActive ? 'page' : undefined}
            >
              {work.data.project}
            </a>
          </li>
        );
      })
    }
  </ul>

</nav>
