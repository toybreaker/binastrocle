{
  "name": "binastrocle",
  "version": "1.2.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Rokma (https://junglestar.org) and Samantha Her",
  "scripts": {
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "dev": "astro dev --open",
    "check": "astro check --watch & astro dev",
    "build": "astro check && astro build --force",
    "buildv": "astro build --verbose",
    "builddev": "astro build --devOutput",
    "buildwithtest": "astro check && tsc --noEmit && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "upg": "npx @astrojs/upgrade"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/netlify": "^8.2.12",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@emnapi/runtime": "1.11.3"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.23.4"
  }
}
